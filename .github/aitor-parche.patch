diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 8bec33e..0559180 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -28,10 +28,11 @@ jobs:
           node-version: '22'
           cache: npm
 
-      # `npm install` en vez de `npm ci`: no falla si el lockfile quedó desfasado
-      # tras editar package.json desde la web de GitHub.
+      # `npm ci` en vez de `npm install`: instala exactamente el árbol del
+      # lockfile y falla si `package.json` no cuadra con él. Con `npm install`,
+      # un lockfile desfasado se arreglaba en silencio y la CI medía otra cosa.
       - name: Install dependencies
-        run: npm install --no-audit --no-fund
+        run: npm ci --no-audit --no-fund
 
       - name: Build
         run: npm run build
