# AiTor — variables de entorno del frontend (Vite)
#
# Copia este fichero a `.env.local` y rellena lo que necesites. Todos los
# valores son públicos (van embebidos en el bundle del navegador): las
# claves privadas de Supabase no viven aquí, van en las Edge Functions.
#
# Si una variable no está definida, el código usa la configuración del
# proyecto de producción embebida en src/integrations/supabase/client.ts, así
# que el arranque local funciona sin tocar nada.

# Proyecto de Supabase (Authentication, Edge Functions, base de datos)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave publicable (antes "anon"). Es pública por diseño: viaja al navegador.
VITE_SUPABASE_PUBLISHABLE_KEY=tu_clave_publicable
# Alias antiguo; se acepta mientras exista la publicable.
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile — protege el registro y el envío de códigos OTP.
# 1. Crea un widget en https://dash.cloudflare.com/turnstile (modo invisible).
# 2. Pon la CLAVE PÚBLICA (site key) aquí y la secreta en
#    Supabase → Settings → Captcha.
# Sin esta variable todo sigue funcionando: simplemente no se envía token.
VITE_TURNSTILE_SITEKEY=
