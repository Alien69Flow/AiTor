# Copia a .env.local y rellena lo que uses. Nunca subas .env.local.
#
# Sin UPSTASH_* todo funciona, pero sin caché compartida: cada petición va a
# la fuente y /api/health responde UNCONFIGURED. Con ellas, además, el ETag de
# /api/traffic se vuelve estable y aparecen los 304.

# --- Caché y límites (Upstash Redis, REST) ------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Opcionales (valores por defecto entre paréntesis)
REDIS_TIMEOUT_MS=1500
REDIS_PIPELINE_TIMEOUT_MS=4000

# --- CORS ---------------------------------------------------------------
# Orígenes extra separados por coma. Los propios ya van en api/_shared/cors.ts.
ALLOWED_ORIGINS=

# --- /api/health --------------------------------------------------------
# Sin esta clave, ?compact=1 da el resumen público y el detalle queda oculto.
OPERATOR_KEY=

# --- Lectura de GitHub --------------------------------------------------
# Sin token: 60 lecturas/hora por IP. Con token: 5000/hora.
GITHUB_TOKEN=
# El token solo se usa con estos repositorios (separados por coma).
GITHUB_REPO_ALLOWLIST=Alien69Flow/AiTor
