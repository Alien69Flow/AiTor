# Copia a .env.local y rellena lo que uses. Nunca subas .env.local.
#
# Sin caché compartida todo funciona, pero cada petición va a la fuente y
# /api/health responde UNCONFIGURED. Con ella, además, el ETag de /api/traffic
# se vuelve estable y aparecen los 304.

# --- Caché y límites (Upstash Redis, REST) -------------------------------
# Vale cualquiera de los dos pares; el código acepta ambos.
#
#   a) Vercel → Storage → Upstash (Marketplace): crea KV_REST_API_URL y
#      KV_REST_API_TOKEN solo, sin copiar nada a mano. RECOMENDADO.
#   b) Panel de Upstash → tu base → REST API: copia UPSTASH_REDIS_REST_URL y
#      UPSTASH_REDIS_REST_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Opcionales (valores por defecto entre paréntesis)
REDIS_TIMEOUT_MS=1500
REDIS_PIPELINE_TIMEOUT_MS=4000

# --- CORS ---------------------------------------------------------------
ALLOWED_ORIGINS=

# --- /api/health --------------------------------------------------------
# Sin esta clave, ?compact=1 da el resumen público y el detalle queda oculto.
OPERATOR_KEY=

# --- Lectura de GitHub --------------------------------------------------
# Sin token: 60 lecturas/hora por IP. Con token: 5000/hora.
GITHUB_TOKEN=
GITHUB_REPO_ALLOWLIST=Alien69Flow/AiTor

# --- Telegram (bot) -----------------------------------------------------
# Diagnóstico sin sacar secretos: GET /api/telegram-webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MANUS_API_KEY=
# El webhook llama a la función `chat` de Supabase con estas dos.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PUBLIC_URL=https://aitor.alienflow.space
# Tope diario de respuestas del modelo por chat (40 si no se define). No es
# secreto: se puede cambiar en Vercel sin tocar código. El contador es exacto
# entre invocaciones sólo con Redis (arriba); sin Redis cuenta por instancia y
# `/estado` lo dice en la línea «Gasto del chat».
CHAT_DAILY_TURN_LIMIT=
