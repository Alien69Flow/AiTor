{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "api/_shared/**/*.ts",
    "api/**/*.test.ts",
    "tests/**/*.test.ts",
    "api/health.ts",
    "api/gdelt.ts",
    "api/traffic.ts",
    "api/bitnodes.ts",
    "api/github.ts"
  ]
}
