SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Legacy projects may use SUPABASE_ANON_KEY instead.
# Server-only. Never expose this through Vite or the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Model and integration secrets belong in Supabase/Lovable secrets or the backend runtime,
# not in source control.
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
