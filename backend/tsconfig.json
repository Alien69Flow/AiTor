{
  "compilerOptions": {
    "target": "ES2022",
    // `bundler` en vez de `NodeNext`: el código usa imports sin extensión
    // (`./agents/supervisor`) y con NodeNext cada uno era un error. Aquí el
    // emisor sigue siendo ESM (`type: module`), así que el runtime resuelve
    // igual que antes; lo que desaparece es una regla que el proyecto nunca
    // cumplió y que impedía compilar.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    // El servidor MCP vive en `src/lib/mcp` porque lo comparten el navegador y
    // este proceso: la raíz sube un nivel para poder compilarlo, y por eso el
    // arranque apunta a `dist/backend/server.js`.
    "rootDir": "../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts", "../src/lib/mcp/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
